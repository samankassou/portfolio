# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Your email address where contact form submissions will be sent
CONTACT_EMAIL=

# Verified sender identity used by Resend
RESEND_FROM_EMAIL="Portfolio Contact <portfolio@samankassou.com>"

# Shared contact rate limiter (Upstash Redis REST credentials, server-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
